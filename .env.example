# Copy to .env if you want local overrides. `bun run paws` runs without any of these set.
# Hosted (Railway) variables are listed after the local ones. See docs/railway.md.

# Home directory for the SQLite database, secrets, worktrees, and logs.
# Default: ~/.paws. On Railway, set this to the volume mount, for example /data.
PAWS_HOME=

# local (default) or hosted. Railway also turns hosted mode on when
# RAILWAY_ENVIRONMENT or RAILWAY_PROJECT_ID is set. PAWS_MODE=local forces local mode.
PAWS_MODE=

# HTTP bind. Local mode listens on localhost. Hosted mode binds 0.0.0.0 and
# prefers Railway's PORT over PAWS_PORT.
PAWS_HOST=127.0.0.1
PAWS_PORT=8787

# Public URL. Locally, an https ngrok dev domain makes `bun run paws` start
# `ngrok http --url=<this> <port>` unless `--no-tunnel` or PAWS_NO_TUNNEL=1 is set.
# Hosted mode does not start ngrok. It uses https://$RAILWAY_PUBLIC_DOMAIN when
# PAWS_PUBLIC_URL is empty.
PAWS_PUBLIC_URL=
PAWS_NO_TUNNEL=
NGROK_AUTHTOKEN=

# Linear OAuth app installed with actor=app.
# Scopes: read,write,app:assignable,app:mentionable
# Enable the Agent session events webhook category and point it at
# https://<public-host>/webhooks/linear
# The webhook secret is the HMAC key for the Linear-Signature header.
# Locally, tokens are stored in ~/.paws/secrets/linear-oauth.json (mode 0600) and refreshed.
# Hosted mode reads the client id, client secret, webhook secret, and tokens from
# the environment. A refresh is still written on the volume under $PAWS_HOME/secrets.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=
LINEAR_ACCESS_TOKEN=
LINEAR_REFRESH_TOKEN=

# GitHub App installed on one repo.
# Local mode: point GITHUB_APP_PRIVATE_KEY_PATH at a file under ~/.paws/secrets (mode 0600).
# Hosted mode: set GITHUB_APP_PRIVATE_KEY to the PEM (newlines or \n escapes).
# Do not commit the key. It is not passed to the agent.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Model auth for hosted agents. Local mode strips these and uses the developer's login.
# Set an API key, or a base URL for a model proxy. PAWS_MODEL_PROXY_URL fills both
# base URLs when the provider-specific ones are empty.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
PAWS_MODEL_PROXY_URL=

# Required in hosted mode because /status is on the public hostname.
# Bearer token, or the password of HTTP Basic. At least 16 characters.
# Leave empty locally to keep /status open on localhost.
PAWS_DASHBOARD_TOKEN=

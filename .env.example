# Copy to .env if you want local overrides. `bun run paws` runs without any of these set.

# Home directory for the SQLite database, secrets, worktrees, and logs.
# Default: ~/.paws
PAWS_HOME=

# HTTP bind. The quick MVP listens on localhost only.
PAWS_HOST=127.0.0.1
PAWS_PORT=8787

# Public tunnel URL. When this is an https ngrok dev domain, `bun run paws` starts
# `ngrok http --url=<this> <port>` unless `--no-tunnel` or PAWS_NO_TUNNEL=1 is set.
PAWS_PUBLIC_URL=
PAWS_NO_TUNNEL=
NGROK_AUTHTOKEN=

# Linear OAuth app installed with actor=app.
# Scopes: read,write,app:assignable,app:mentionable
# Enable the Agent session events webhook category and point it at
# https://<dev-domain>/webhooks/linear
# The webhook secret is the HMAC key for the Linear-Signature header.
# Tokens are stored in ~/.paws/secrets/linear-oauth.json (mode 0600) and refreshed.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=
LINEAR_ACCESS_TOKEN=
LINEAR_REFRESH_TOKEN=

# GitHub App installed on one repo. Point the private key at a file under ~/.paws/secrets
# (mode 0600). Do not put the key itself in the environment.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
# The one repository the GitHub App is installed on, as owner/repo.
PAWS_GITHUB_REPOSITORY=

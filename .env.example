# Copy to .env if you want local overrides. `bun run paws` runs without any of these set.

# Home directory for the SQLite database, secrets, worktrees, and logs.
# Default: ~/.paws
PAWS_HOME=

# HTTP bind. The quick MVP listens on localhost only.
PAWS_HOST=127.0.0.1
PAWS_PORT=8787

# Public tunnel URL (ngrok dev domain). Unused until the tunnel child process lands.
PAWS_PUBLIC_URL=

# Linear OAuth app. The webhook secret is the HMAC key for the Linear-Signature header.
LINEAR_WEBHOOK_SECRET=

# GitHub App installed on one repo. Point the private key at a file under ~/.paws/secrets
# (mode 0600). Do not put the key itself in the environment.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

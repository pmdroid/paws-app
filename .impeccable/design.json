  "narrative": {
    "northStar": "The Lavender Desktop",
    "overview": "A familiar personal-computer desktop becomes a warm home for Paws. Cool lavender surrounds near-white software windows with crisp near-black outlines. Baloo 2 gives the hero a rounded, friendly voice; Bricolage carries the remaining headings, prose, and actions, while DM Mono supplies software captions and commands.\n\nSpacious copy sits beside compact window furniture. Orange actions feel tactile, green checkmarks communicate completion, and a sleeping pixel puppy warms the dark terminal. Containment and contrasting surfaces create depth without shadows.",
    "keyCharacteristics": [
      "Cool lavender desktop and caption bars surrounding near-white content.",
      "Rounded Baloo 2 hero, Bricolage supporting type, and DM Mono software details.",
      "Crisp outlines, modest rounded corners, and circular status marks.",
      "A separate timeline rail beside recognizable tool symbols.",
      "Orange actions, visible keyboard focus, and reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Shared Desktop Rule",
        "body": "Window caption bars repeat the desktop lavender so nested windows belong to the same workspace.",
        "section": "colors"
      },
      {
        "name": "The State Has a Shape Rule",
        "body": "Completion uses a checkmark as well as green; selected workflow controls use a border as well as a changed fill.",
        "section": "colors"
      },
      {
        "name": "The Three Voices Rule",
        "body": "Use Baloo 2 for the hero headline, Bricolage for other headings, prose, and actions, and DM Mono for window captions, commands, and compact status details.",
        "section": "typography"
      },
      {
        "name": "The Outlined Window Rule",
        "body": "Define window edges with ink borders and contrasting caption bars; keep their rounded silhouettes intact through clipped overflow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do repeat desktop lavender in window captions and use paper for readable content.",
      "Do reserve Baloo 2 for the hero and pair Bricolage supporting type with DM Mono software details.",
      "Do preserve outlined rounded windows, separate timeline nodes, and recognizable official tool symbols.",
      "Do keep keyboard focus visible and expose selected workflow state with aria-pressed.",
      "Do retain tool names and give terminal copy and the puppy separate space on mobile.",
      "Do honor reduced-motion preferences for entrance and anchor scrolling."
    ],
    "donts": [
      "Don't turn decorative window dots into fake interactive controls.",
      "Don't use color alone to communicate completion or workflow selection.",
      "Don't substitute shadows for the outlined, tonally layered window structure."
    ]
  }
}

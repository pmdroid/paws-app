polkit.addRule(function (action, subject) {
  if (action.id !== "org.freedesktop.systemd1.manage-units" || subject.user !== "paws-runner") return;
  var unit = action.lookup("unit");
  var verb = action.lookup("verb");
  if (
    (verb === "start" || verb === "stop") &&
    /^paws-issue-vm@[0-7][0-9A-HJKMNP-TV-Z]{25}-(?:[1-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-4])-(?:[1-9]|[12][0-9]|3[0-2])-(?:[1-9]|[1-9][0-9]|1[01][0-9]|12[0-8])\.service$/.test(unit || "")
  )
    return polkit.Result.YES;
});

polkit.addRule(function (action, subject) {
  if (action.id !== "org.freedesktop.systemd1.manage-units" || subject.user !== "paws-runner") return;
  var unit = action.lookup("unit");
  var verb = action.lookup("verb");
  var instance =
    /^[0-7][0-9A-HJKMNP-TV-Z]{25}-(?:[1-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-4])-(?:[1-9]|[12][0-9]|3[0-2])-(?:[1-9]|[1-9][0-9]|1[01][0-9]|12[0-8])$/;
  var match = /^(paws-issue-vm|paws-issue-vm-sleep-check)@(.*)\.service$/.exec(unit || "");
  if (match === null || !instance.test(match[2])) return;
  if (match[1] === "paws-issue-vm" ? verb === "start" || verb === "stop" : verb === "start")
    return polkit.Result.YES;
});

polkit.addRule(function (action, subject) {
  if (action.id !== "org.freedesktop.systemd1.manage-units" || subject.user !== "paws-runner") return;
  var unit = action.lookup("unit");
  var verb = action.lookup("verb");
  if ((verb === "start" || verb === "stop") && /^paws-agent@[0-7][0-9A-HJKMNP-TV-Z]{25}\.service$/.test(unit || ""))
    return polkit.Result.YES;
  if ((verb === "start" || verb === "stop") && /^paws-issue-vm-network@(?:[1-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-4])\.service$/.test(unit || ""))
    return polkit.Result.YES;
});

[Unit]
Description=Paws trusted verification witness %i
Requires=paws-runner-broker.socket
After=paws-runner-broker.socket

[Service]
Type=exec
User=root
Group=root
SupplementaryGroups=paws-check-input paws-runner paws-check-metadata
ExecCondition=/usr/bin/python3 -I -B /opt/paws-runner/current/deploy/linux/check-broker.py guard-check-witness %i
ExecStart=/usr/bin/python3 -I -B /opt/paws-runner/current/deploy/linux/check-witness.py %i
KillMode=control-group
KillSignal=SIGKILL
TimeoutStartSec=30s
TimeoutStopSec=5s
RuntimeMaxSec=2400s
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/paws-check-control /var/lib/paws-check-attempts /var/lib/paws-check-metadata /var/lib/paws-check-broker /var/lib/paws-check-results
InaccessiblePaths=-/var/lib/paws-runner -/var/lib/paws-agent -/var/lib/paws-runner-broker -/run/user -/run/dbus

u paws-runner - "Paws runner daemon" /var/lib/paws-runner /usr/sbin/nologin
u paws-agent - "Paws coding agents" /var/lib/paws-agent /usr/sbin/nologin
g paws-results -
m paws-runner paws-agent
m paws-runner paws-results
m paws-agent paws-results
u paws-check - "Paws verification commands" /var/lib/paws-check /usr/sbin/nologin
g paws-check-input -
m paws-runner paws-check-input
g paws-check-metadata -

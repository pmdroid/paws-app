[Unit]
Description=Paws paired Linux runner daemon
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=paws-runner
Group=paws-runner
SupplementaryGroups=paws-agent paws-results
Environment=HOME=/var/lib/paws-runner
StateDirectory=paws-runner
StateDirectoryMode=0700
WorkingDirectory=/var/lib/paws-runner
ExecStart=/opt/paws-runner/bin/paws-runner runner daemon --config /etc/paws-runner/config.json
SuccessExitStatus=130
Restart=on-failure
RestartSec=5s
KillMode=control-group
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/paws-runner-spool
ReadWritePaths=/var/lib/paws-agent
ReadWritePaths=/var/lib/paws-agent-results
ReadWritePaths=/var/lib/paws-agent-tasks
ReadWritePaths=/var/lib/paws-runner-members

[Install]
WantedBy=multi-user.target

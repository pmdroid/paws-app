[Unit]
Description=Paws agent execution %i

[Service]
Type=exec
User=paws-agent
Group=paws-agent
Environment=HOME=/var/lib/paws-agent
StateDirectory=paws-agent
StateDirectoryMode=0700
WorkingDirectory=/var/lib
ExecStart=/opt/paws-runner/bin/paws-runner runner worker --execution-id %i
KillMode=control-group
KillSignal=SIGKILL
TimeoutStartSec=30s
TimeoutStopSec=30s
SendSIGKILL=yes
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=

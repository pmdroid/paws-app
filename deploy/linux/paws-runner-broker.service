[Unit]
Description=Paws check broker
Requires=paws-runner-broker.socket
After=paws-runner-broker.socket

[Service]
ExecStart=/usr/bin/python3 -I /opt/paws-runner/current/deploy/linux/check-broker.py
User=root
Group=root
SupplementaryGroups=paws-check-input paws-check-metadata
UMask=0077
Restart=on-failure
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
InaccessiblePaths=-/var/lib/paws-runner
ReadWritePaths=/var/lib/paws-check-control /var/lib/paws-check-attempts /var/lib/paws-check-metadata /var/lib/paws-check-broker /run/systemd/system

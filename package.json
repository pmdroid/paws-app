{
  "name": "paws",
  "private": true,
  "type": "module",
  "scripts": {
    "paws": "bun src/index.ts",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit && tsc -p src/web/tsconfig.client.json --noEmit",
    "test": "bun test --parallel=4 --timeout=20000",
    "links": "bun scripts/check-markdown-links.ts",
    "migrate:dry-run": "bun scripts/migrate-dry-run.ts",
    "check": "bun run lint && bun run fmt:check && bun run typecheck && bun run test && bun run build:status && bun run links",
    "build:status": "bun src/web/build.ts",
    "verify:local": "bun --no-env-file scripts/verify-local.ts",
    "verify:ui": "bun run build:status && bun --no-env-file scripts/verify-status-ui.ts"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.88.0",
    "@agentclientprotocol/codex-acp": "2.1.1",
    "@agentclientprotocol/sdk": "1.8.0",
    "@xai-official/grok": "1.0.50",
    "ajv": "8.20.0",
    "yaml": "2.9.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "happy-dom": "^21.0.4",
    "html-react-parser": "^6.1.8",
    "lucide-react": "^1.56.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "video.js": "^8.24.1"
  }
}

    "check": "bun run lint && bun run fmt:check && bun run typecheck && bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2"
  }
}

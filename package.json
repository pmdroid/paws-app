{
  "name": "paws",
  "private": true,
  "type": "module",
  "scripts": {
    "paws": "bun src/index.ts",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
